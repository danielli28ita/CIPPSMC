# Simulator only: log_1.ulg BPP/F8 settings. X500 sensors/mapping are set separately.
param set BPP_ACC_FLOOR 0.0500000007
param set BPP_ACC_XY 6
param set BPP_ACC_Z 10
param set BPP_AMAX_XY 0.720000029
param set BPP_AMAX_Z 0.899999976
param set BPP_BAND_XY 0.75
param set BPP_BAND_Z 0.75
param set BPP_DELTA 0.100000001
param set BPP_E0_MIN 0.0500000007
param set BPP_EPS_PRE 0.100000001
param set BPP_EPS_SLIDE 0.100000001
param set BPP_K0_XY 1.29999995
param set BPP_K0_Z 1.89999998
param set BPP_K1_XY 0.25
param set BPP_K1_Z 0.400000006
param set BPP_KS_XY 1.70000005
param set BPP_KS_Z 2
param set BPP_PHI_XY 1.5
param set BPP_PHI_Z 1.20000005
param set BPP_TRIG_RAMP 0.300000012
param set BPP_TRIG_XY 0.75999999
param set BPP_TRIG_Z 0.949999988
param set BPP_T_PRE 2
param set BPP_T_SLIDE 2
param set F8_ENABLE 1
param set F8_ERR_MAX 3
