+	parameters.trigger_fraction = Vector3f(_param_bpp_trig_xy.get(), _param_bpp_trig_xy.get(), _param_bpp_trig_z.get());
+	parameters.surface_gain = Vector3f(_param_bpp_ks_xy.get(), _param_bpp_ks_xy.get(), _param_bpp_ks_z.get());
+	parameters.reaching_gain = Vector3f(_param_bpp_k0_xy.get(), _param_bpp_k0_xy.get(), _param_bpp_k0_z.get());
+	parameters.switching_gain = Vector3f(_param_bpp_k1_xy.get(), _param_bpp_k1_xy.get(), _param_bpp_k1_z.get());
